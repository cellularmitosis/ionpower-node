<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>{{title}}</title>
<style>
body { font-family: "Lucida Grande", sans-serif; max-width: 42em;
       margin: 2em auto; padding: 0 1em; line-height: 1.5; color: #222; }
h1, h2, h3 { line-height: 1.2; }
pre { background: #f4f4f4; padding: 0.8em; overflow-x: auto;
      border-left: 3px solid #888; }
code { background: #f4f4f4; padding: 0.1em 0.3em; }
pre code { background: transparent; padding: 0; }
blockquote { border-left: 3px solid #ccc; margin: 0; padding: 0.3em 1em;
             color: #555; }
/* prism token colors — a small subset */
.token.keyword    { color: #07a; font-weight: bold; }
.token.function   { color: #d70; }
.token.string     { color: #690; }
.token.number     { color: #905; }
.token.comment    { color: #888; font-style: italic; }
.token.operator   { color: #900; }
.token.punctuation{ color: #555; }
.token.selector   { color: #07a; font-weight: bold; }
.token.property   { color: #905; }
footer { margin-top: 3em; color: #888; font-size: 0.85em; border-top: 1px solid #eee; padding-top: 1em; }
</style>
</head>
<body>
{{{body}}}
<footer>
built by ionpower-node from <code>{{source}}</code> on PowerPC Tiger
{{#if author}} &mdash; <em>by {{author}}</em>{{/if}}
{{#if date}} on {{date}}{{/if}}
</footer>
</body>
</html>
