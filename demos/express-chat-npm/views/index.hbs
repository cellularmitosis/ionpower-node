<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>ionpower-node express-chat</title>
<meta name="viewport" content="width=device-width, initial-scale=1">
<link rel="stylesheet" href="/static/style.css">
</head>
<body>
<header>
    <h1>ionpower-node express-chat</h1>
    <span class="banner" id="banner">loading&hellip;</span>
    <span class="status" id="status">offline</span>
</header>
<main>
    <div id="feed"></div>
</main>
<form id="postform" autocomplete="off">
    <div class="form-row form-row-half">
        <label for="name-in">Name (blank = Anonymous)</label>
        <input type="text" id="name-in" maxlength="24">
    </div>
    <div class="form-row form-row-half">
        <label for="trip-in">Tripcode (optional secret)</label>
        <input type="text" id="trip-in">
    </div>
    <div class="form-row form-row-message">
        <label for="text-in">Message &mdash; Ctrl/Cmd+Enter to post</label>
        <div class="form-row-message-inner">
            <textarea id="text-in" maxlength="1024" rows="2"></textarea><button type="submit">Post</button>
        </div>
    </div>
</form>
<script>
window.__BANNER__    = {{{banner}}};
window.__POSTS__     = [];
window.__WS_PORT__   = {{wsport}};
</script>
<script src="/static/client.js"></script>
</body>
</html>
